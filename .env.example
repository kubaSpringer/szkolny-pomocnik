# Local Postgres (createdb szkolny_pomocnik)
# or a Neon "development" branch: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://localhost:5432/szkolny_pomocnik
# Google Cloud Console -> Google Auth Platform -> Clients -> Web application.
# Use the Client ID (ends with .apps.googleusercontent.com), NOT the client secret (GOCSPX-...)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Comma-separated list of Gmail addresses allowed to log in (empty = everyone)
ALLOWED_EMAILS=corka@gmail.com,rodzic@gmail.com
# Any long random string
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
