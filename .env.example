# Local Postgres (createdb szkolny_pomocnik)
DATABASE_URL=postgres://localhost:5432/szkolny_pomocnik
# Set to "true" when the DB needs SSL (e.g. Render external URL)
DATABASE_SSL=false
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Comma-separated list of Gmail addresses allowed to log in (empty = everyone)
ALLOWED_EMAILS=corka@gmail.com,rodzic@gmail.com
# Any long random string
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
